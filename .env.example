# URL de votre instance Portainer (sans slash final)
PORTAINER_URL=https://portainer.example.com:9443

# Clé API Portainer (Mon compte > Access tokens)
PORTAINER_API_KEY=ptr_xxxxxxxxxxxxxxxxxxxx

# ID de l'environnement Docker dans Portainer (souvent 1)
PORTAINER_ENDPOINT_ID=1

# Port du serveur Plustainer
PORT=3456
